{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "'/usr/local/bin/rucksack' hook cursor # rucksack-managed",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "'/usr/local/bin/rucksack' hook cursor # rucksack-managed",
        "timeout": 5
      }
    ],
    "beforeShellExecution": [
      {
        "command": "'/usr/local/bin/rucksack' hook cursor # rucksack-managed",
        "timeout": 5
      }
    ],
    "afterShellExecution": [
      {
        "command": "'/usr/local/bin/rucksack' hook cursor # rucksack-managed",
        "timeout": 5
      }
    ],
    "afterFileEdit": [
      {
        "command": "'/usr/local/bin/rucksack' hook cursor # rucksack-managed",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "'/usr/local/bin/rucksack' hook cursor # rucksack-managed",
        "timeout": 5
      }
    ],
    "sessionEnd": [
      {
        "command": "'/usr/local/bin/rucksack' hook cursor # rucksack-managed",
        "timeout": 5
      }
    ]
  }
}
