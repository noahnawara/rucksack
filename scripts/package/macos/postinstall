#!/bin/sh
set -eu

helper_label=io.rucksack.helper
plist_path=/Library/LaunchDaemons/io.rucksack.helper.plist

/usr/bin/install -d -o root -g wheel -m 0700 /var/db/rucksack
/usr/sbin/chown root:wheel \
    /usr/local/bin/rucksack \
    /Library/PrivilegedHelperTools/io.rucksack.helper \
    "$plist_path"
/bin/chmod 0755 \
    /usr/local/bin/rucksack \
    /Library/PrivilegedHelperTools/io.rucksack.helper
/bin/chmod 0644 "$plist_path"

# `bootstrap` fails when the daemon is already registered, which is the ordinary state on a
# reinstall, and under `set -e` that failed the whole install after every file had been written.
# `kickstart -k` is the call that has to succeed: it starts the daemon, and restarts it if it was
# already running, so it is the one that proves the new binary is the one now serving.
/bin/launchctl bootstrap system "$plist_path" || true
/bin/launchctl kickstart -k "system/$helper_label"
